# The organization's ".github" repository (directory is "dot-github" because
# dot-directories are hidden and skipped by shell globs).
KIND="repo"
REPO=".github"
DISPLAY_NAME=".github"

ACCENT="#4ADE80"            # green: community health / meta
GLYPH_COLOR="#052E16"

GLYPH_TEXT=".gh"
GLYPH_FILE=""

TAGLINE_1="Organization profile, community health"
TAGLINE_2="files, templates & shared assets."
