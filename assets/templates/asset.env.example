# Asset-set definition, read by tools/scaffold-assets.sh.
# Copy to assets/<slug>/asset.env (or run `tools/scaffold-assets.sh <slug>`), edit, then
# run `tools/scaffold-assets.sh --force <slug>` and `tools/generate-assets.sh <slug>`.
# Text values are plain text; XML escaping is handled by the script.

KIND="repo"                 # "org" (organization only) or "repo"
REPO="example"              # GitHub repository name ("dialectic-playground" for KIND=org)
DISPLAY_NAME="example"      # Name shown in the logo/social preview (usually == REPO)

ACCENT="#A78BFA"            # Synthesis (lens) color — see the palette registry in assets/README.md
GLYPH_COLOR="#FFFFFF"       # Glyph color; must contrast with ACCENT

GLYPH_TEXT="ex"             # 1–3 character text glyph (language repos: py, rs, go, …)
GLYPH_FILE=""               # OR a glyph name from assets/templates/glyphs/ (takes precedence)

TAGLINE_1="One-line description of the repository,"
TAGLINE_2="optionally continued on a second line."
